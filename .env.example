# GEMINI_API_KEY: Required for Gemini AI API calls (not used by MEDRADAR demo mode).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# MEDRADAR Official Support Email & SMTP Configuration (Server-Side Only)
# Replace placeholder below with your real support inbox before enabling delivery.
# ------------------------------------------------------------------------------
SUPPORT_EMAIL="your-support-email@example.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MEDRADAR Support <no-reply@example.com>"

# ------------------------------------------------------------------------------
# MEDRADAR Real SMS Verification (Twilio Verify or Twilio Messaging)
# Required for sending real OTP codes to mobile numbers. Never exposed to browser.
# Option A (Recommended): Twilio Verify Service
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
# Option B (Alternative if not using Verify Service): Twilio Messaging Phone Number
TWILIO_FROM_NUMBER=""

# ------------------------------------------------------------------------------
# Server Session & Support Team Review Security
# ------------------------------------------------------------------------------
SESSION_SECRET=""
SUPPORT_ADMIN_PHONES=""
SUPPORT_TEAM_PASSCODE=""
